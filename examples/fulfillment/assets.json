  {
    "id": "order-review-policy",
    "name": "Order Review Policy",
    "type": "tree",
    "contract": {
      "inputs": {
        "type": "object",
        "required": [
          "hasRestricted",
          "subtotal"
        ],
        "properties": {
          "subtotal": {
            "type": "number",
            "example": 161
          },
          "hasRestricted": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "requiresReview",
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "example": "Automatic approval"
          },
          "requiresReview": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "variables": {
        "type": "object",
        "properties": {}
      }
    },
    "definition": {
      "tiles": [
        {
          "id": "start",
          "yes": "restricted",
          "kind": "start",
          "title": "Start",
          "assignments": []
        },
        {
          "id": "restricted",
          "no": "high-value",
          "yes": "restricted-result",
          "kind": "condition",
          "title": "Restricted items?",
          "condition": {
            "group": {
              "id": "restricted",
              "op": "and",
              "type": "group",
              "children": [
                {
                  "id": "restricted-condition",
                  "path": "hasRestricted",
                  "type": "condition",
                  "value": "true",
                  "operator": "$eq"
                }
              ]
            }
          },
          "assignments": []
        },
        {
          "id": "high-value",
          "no": "approved-result",
          "yes": "value-result",
          "kind": "condition",
          "title": "Order over 500?",
          "condition": {
            "group": {
              "id": "value",
              "op": "and",
              "type": "group",
              "children": [
                {
                  "id": "value-condition",
                  "path": "subtotal",
                  "type": "condition",
                  "value": "500",
                  "operator": "$gt"
                }
              ]
            }
          },
          "assignments": []
        },
        {
          "id": "restricted-result",
          "kind": "result",
          "title": "Review restricted goods",
          "assignments": [
            {
              "id": "restricted-result-review",
              "path": "requiresReview",
              "value": "true"
            },
            {
              "id": "restricted-result-reason",
              "path": "reason",
              "value": "Restricted item requires review"
            }
          ]
        },
        {
          "id": "value-result",
          "kind": "result",
          "title": "Review high value order",
          "assignments": [
            {
              "id": "value-result-review",
              "path": "requiresReview",
              "value": "true"
            },
            {
              "id": "value-result-reason",
              "path": "reason",
              "value": "Order exceeded 500"
            }
          ]
        },
        {
          "id": "approved-result",
          "kind": "result",
          "title": "Approve order",
          "assignments": [
            {
              "id": "approved-result-review",
              "path": "requiresReview",
              "value": "false"
            },
            {
              "id": "approved-result-reason",
              "path": "reason",
              "value": "Automatic approval"
            }
          ]
        }
      ],
      "positions": {
        "start": {
          "x": 380,
          "y": 30
        },
        "high-value": {
          "x": 620,
          "y": 330
        },
        "restricted": {
          "x": 380,
          "y": 160
        },
        "value-result": {
          "x": 410,
          "y": 510
        },
        "approved-result": {
          "x": 850,
          "y": 510
        },
        "restricted-result": {
          "x": 60,
          "y": 330
        }
      }
    },
    "description": "Restricted items or orders over 500 require review; otherwise approve automatically."
